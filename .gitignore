# Dependencies
node_modules/
**/node_modules/

# Next.js & Build outputs
.next/
**/.next/
out/
build/
dist/

# Real Environment files (exclude real secrets, track examples)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs & coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Backend Runtime Upload Files (Preserve folder structure via .gitkeep)
admin-api/uploads/*
!admin-api/uploads/.gitkeep
!admin-api/uploads/portfolio/
!admin-api/uploads/clients/
admin-api/uploads/portfolio/*
!admin-api/uploads/portfolio/.gitkeep
admin-api/uploads/clients/*
!admin-api/uploads/clients/.gitkeep
